# Tavily API key for web search
# Get your key at: https://tavily.com/
TAVILY_API_KEY=***

# OpenRouter API key for LLM
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=***

# Optional: Override default model (minimax/minimax-m3)
# Examples: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-pro-1.5
# LLM_MODEL=minimax/minimax-m3
